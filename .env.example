# Copy this file to `.env` (local) and add the same variables in Vercel → Settings → Environment Variables.
# These are SERVER-ONLY secrets: they are never sent to the browser. See SETUP.md.

# MongoDB Atlas connection string: Atlas → Connect → Drivers. Replace <password> with your database user's password
# (URL-encode special characters, e.g. @ becomes %40).
MONGODB_URI=
# Database name (created automatically on first use).
MONGODB_DB=techies_taste

# Owner login for /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Long random string that signs the owner's login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
