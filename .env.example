# Firebase web app config: Firebase console → Project settings → General → Your apps → SDK setup and configuration.
# Copy this file to `.env` (local) and add the same variables in Vercel/Netlify (production).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Only needed for uploading menu photos from the admin panel (Firebase Storage).
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
